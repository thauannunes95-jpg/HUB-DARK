
local function addToggle(parent, name, callback)
    local enabled = false

    local b = button(parent, name .. "  [OFF]", function()
        enabled = not enabled
        b.Text = name .. (enabled and "  [ON]" or "  [OFF]")
        b.BackgroundColor3 = enabled
            and Color3.fromRGB(48, 65, 80)
            or COLORS.card

        if callback then
            callback(enabled)
        end
    end, 40)

    return b
end

local function addSlider(parent, title, minValue, maxValue, defaultValue)
    local holder = make("Frame", {
        Size = UDim2.new(1, 0, 0, 68),
        BackgroundColor3 = COLORS.card
    }, parent)
    round(holder, 8)

    local value = defaultValue
    local titleLabel = label(holder, title .. ": " .. value, 12,
        UDim2.fromOffset(10, 5), UDim2.new(1, -20, 0, 22), 12)

    local track = make("Frame", {
        Position = UDim2.new(0, 10, 0, 38),
        Size = UDim2.new(1, -20, 0, 8),
        BackgroundColor3 = COLORS.bg
    }, holder)
    round(track, 6)

    local fill = make("Frame", {
        Size = UDim2.new(
            (value - minValue) / (maxValue - minValue), 0, 1, 0
        ),
        BackgroundColor3 = COLORS.accent
    }, track)
    round(fill, 6)

    local dragging = false

    local function setFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local relative = math.clamp(
            (x - track.AbsolutePosition.X) / width, 0, 1
        )

        value = math.floor(
            minValue + relative * (maxValue - minValue) + 0.5
        )

        fill.Size = UDim2.new(
            (value - minValue) / (maxValue - minValue), 0, 1, 0
        )
        titleLabel.Text = title .. ": " .. value
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return function()
        return value
    end
end

