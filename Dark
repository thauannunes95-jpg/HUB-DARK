local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, obj)
end

local function outline(obj, color, thickness)
    make("UIStroke", {
        Color = color or C.purple,
        Thickness = thickness or 1.5
    }, obj)
end

local function label(parent, value, size, position, fontSize)
    return make("TextLabel", {
        Size = size,
        Position = position,
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = C.white,
        TextSize = fontSize or 13,
        Font = Enum.Font.Gotham,
        TextWrapped = true
    }, parent)
end

local function button(parent, value, size, position, callback)
    local b = make("TextButton", {
        Size = size,
        Position = position,
        BackgroundColor3 = C.button,
        BorderSizePixel = 0,
        Text = value,
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextWrapped = true,
        AutoButtonColor = true
    }, parent)

    round(b, 8)
    b.Activated:Connect(callback)
    return b
end

local function notify(value)
    local toast = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -12),
        Size = UDim2.new(0.82, 0, 0, 42),
        BackgroundColor3 = C.purpleDark,
        Text = value,
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextWrapped = true,
        ZIndex = 20
    }, gui)

    round(toast, 9)

    task.delay(2.5, function()
        if toast.Parent then toast:Destroy() end
    end)
end

