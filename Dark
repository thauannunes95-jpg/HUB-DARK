local function createGameMenu(name, options)
    local p = createPage(name)

    section(p, string.upper(name) .. " | MOD MENU")
    row(p, "DARK HUB • " .. name)
    row(p, "Controles visuais do painel")

    action(p, "← VOLTAR AOS JOGOS", function()
        showPage("Jogos")
    end)

    for _, optionName in ipairs(options) do
        local enabled = false
        local b

        b = action(p, optionName .. ": OFF", function()
            enabled = not enabled

            b.Text = optionName .. ": "
                .. (enabled and "ON" or "OFF")

            notify(optionName .. " selecionado")
        end)
    end
end

