local function createPage(name)
    local p = make("ScrollingFrame", {
        Name = name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false
    }, content)

    local layout = make("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, p)

    make("UIPadding", {
        PaddingTop = UDim.new(0, 3),
        PaddingBottom = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 5)
    }, p)

    pages[name] = p
    pageLayout[name] = layout
    return p
end

local function showPage(name)
    if not pages[name] then return end
    for n, p in pairs(pages) do
        p.Visible = n == name
    end
    activePage = name
end

local function section(p, text)
    local s = label(p, text, UDim2.new(1, -3, 0, 34),
        UDim2.new(), 13)
    s.BackgroundColor3 = C.purple
    s.Font = Enum.Font.GothamBold
    round(s, 5)
    return s
end

local function row(p, text, height)
    local r = label(p, text, UDim2.new(1, -3, 0, height or 40),
        UDim2.new(), 13)
    r.BackgroundColor3 = C.panel
    round(r, 8)
    return r
end

local function action(p, text, callback)
    local b = button(p, text, UDim2.new(1, -3, 0, 39),
        UDim2.new(), callback)
    return b
end

local function notify(text)
    local toast = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -12),
        Size = UDim2.new(0.8, 0, 0, 42),
        BackgroundColor3 = C.purpleDark,
        Text = text,
        TextColor3 = C.white,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        ZIndex = 20
    }, gui)
    round(toast, 10)
    task.delay(2.5, function()
        if toast.Parent then toast:Destroy() end
    end)
end

