-- // LÓGICA DE COMBATE (Aimbot & ESP)
local function getClosestPlayer()
    local closest = nil
    local shortestDistance = Settings.Arsenal.FOV
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - UIS:GetMousePosition()).Magnitude
                if dist < shortestDistance then
                    closest = p
                    shortestDistance = dist
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    -- Aimbot Head-Lock
    if Settings.Arsenal.Aimbot then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end

    -- ESP Wallhack
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hl = p.Character:FindFirstChild("DarkESP") or make("Highlight", {Name = "DarkESP", Parent = p.Character})
            if Settings.Arsenal.ESP_Solo or Settings.Arsenal.ESP_Teams then
                hl.Enabled = true
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                if Settings.Arsenal.ESP_Teams and p.Team then
                    hl.FillColor = (p.Team == player.Team) and Theme.Success or Theme.Danger
                else
                    hl.FillColor = Theme.Accent
                end
            else
                hl.Enabled = false
            end
        end
    end

    -- FOV Update
    fovCircle.Size = UDim2.fromOffset(Settings.Arsenal.FOV, Settings.Arsenal.FOV)
    fovCircle.Visible = Settings.Arsenal.ShowFOV
end)

