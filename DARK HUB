local function page(name)
    local p = make("ScrollingFrame", {
        Name = name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false
    }, content)

    make("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, p)

    make("UIPadding", {
        PaddingTop = UDim.new(0, 3),
        PaddingRight = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 8)
    }, p)

    pages[name] = p
    return p
end

local function text(p, value, height)
    return make("TextLabel", {
        Size = UDim2.new(1, -4, 0, height or 34),
        BackgroundColor3 = panel,
        BorderSizePixel = 0,
        Text = value,
        TextColor3 = white,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextWrapped = true
    }, p)
end

local function button(p, value, callback)
    local b = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 38),
        BackgroundColor3 = panel,
        BorderSizePixel = 0,
        Text = value,
        TextColor3 = white,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextWrapped = true
    }, p)
    corner(b, 7)
    b.Activated:Connect(callback)
    return b
end

local function section(p, value)
    local label = text(p, value, 30)
    label.BackgroundColor3 = purple
    label.Font = Enum.Font.GothamBold
    return label
end

