-- UTILITÁRIOS DE UI
local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 9)}, obj)
end

local function outline(obj, color, thickness)
    make("UIStroke", {Color = color or C.purple, Thickness = thickness or 1.5}, obj)
end

local function label(parent, value, size, position, fontSize)
    return make("TextLabel", {
        Size = size, Position = position, BackgroundTransparency = 1,
        Text = value, TextColor3 = C.white, TextSize = fontSize or 13,
        Font = Enum.Font.Gotham, TextWrapped = true
    }, parent)
end

local function button(parent, value, size, position, callback)
    local b = make("TextButton", {
        Size = size, Position = position, BackgroundColor3 = C.button,
        BorderSizePixel = 0, Text = value, TextColor3 = C.white,
        TextSize = 12, Font = Enum.Font.GothamMedium, AutoButtonColor = true
    }, parent)
    round(b, 8)
    b.Activated:Connect(callback)
    return b
end

local function createSlider(parent, text, min, max, default, callback)
    local container = make("Frame", {
        Size = UDim2.new(1, -3, 0, 50), BackgroundColor3 = C.panel, BorderSizePixel = 0
    }, parent)
    round(container, 7)
    local title = label(container, text .. ": " .. default, UDim2.new(1, 0, 0, 20), UDim2.new(0, 10, 0, 0), 12)
    local bar = make("Frame", {
        Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 30), BackgroundColor3 = C.button
    }, container)
    round(bar, 3)
    local fill = make("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = C.purple, BorderSizePixel = 0
    }, bar)
    round(fill, 3)
    local knob = make("TextButton", {
        Size = UDim2.fromOffset(16, 16), Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8),
        BackgroundColor3 = C.white, Text = "", BorderSizePixel = 0
    }, bar)
    round(knob, 8)

    local dragging = false
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local relativeX = math.clamp((mouse.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(relativeX, 0, 1, 0)
            knob.Position = UDim2.new(relativeX, -8, 0.5, -8)
            local value = math.floor(min + (max - min) * relativeX)
            title.Text = text .. ": " .. value
            callback(value)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local function notify(value)
    local toast = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12),
        Size = UDim2.new(0.82, 0, 0, 42), BackgroundColor3 = C.purpleDark,
        Text = value, TextColor3 = C.white, TextSize = 12, Font = Enum.Font.GothamBold, ZIndex = 20
    }, gui)
    round(toast, 9)
    task.delay(2.5, function() if toast.Parent then toast:Destroy() end end)
end

