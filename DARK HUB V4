-- 1. SISTEMA DE ALVOS (Aimbot / Silent Aim)
local function getClosestPlayer()
    local closest = nil
    local shortestDistance = Settings.Arsenal.FOV
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            if onScreen then
                local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                if distance < shortestDistance then
                    closest = v
                    shortestDistance = distance
                end
            end
        end
    end
    return closest
end

-- Silent Aim Hook (Intercepta o disparo para redirecionar ao alvo)
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(t, k)
    if k == "Hit" and (Settings.Arsenal.SilentAim or Settings.MM2.SilentAim) then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            return target.Character.Head.Position
        end
    end
    return oldIndex(t, k)
end)
setreadonly(mt, true)

-- Aimbot Visual
RunService.RenderStepped:Connect(function()
    if Settings.Arsenal.Aimbot then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Character.Head.Position)
        end
    end
end)

-- 2. ESP AVANÇADO (Boxes)
local function createESP(plr)
    local box = make("BoxHandleAdornment", {
        Size = Vector3.new(4, 6, 1),
        AlwaysOnTop = true,
        ZIndex = 10,
        Transparency = 0.5,
        Color3 = C.purple,
        Adornee = nil
    }, game.CoreGui)
    
    RunService.RenderStepped:Connect(function()
        if (Settings.Arsenal.ESP or Settings.MM2.ESP) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            box.Adornee = plr.Character.HumanoidRootPart
            box.Visible = true
            -- Cor especial para MM2
            if game.Name:find("Murder Mystery") then
                local char = plr.Character
                if char:FindFirstChild("Knife") then box.Color3 = Color3.new(1, 0, 0) -- Murder
                elseif char:FindFirstChild("Gun") then box.Color3 = Color3.new(0, 0, 1) -- Sheriff
                else box.Color3 = C.purple end
            end
        else
            box.Visible = false
        end
    end)
end
for _, p in pairs(Players:GetPlayers()) do if p ~= player then createESP(p) end end
Players.PlayerAdded:Connect(createESP)

-- 3. FLY & NOCLIP (Global)
RunService.Stepped:Connect(function()
    if Settings.Global.Noclip and player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

local flySpeed = 50
local bv, bg
task.spawn(function()
    while task.wait() do
        if Settings.Global.Fly and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            if not bv then
                bv = make("BodyVelocity", {Velocity = Vector3.new(0,0,0), MaxForce = Vector3.new(1,1,1)*1e6}, root)
                bg = make("BodyGyro", {MaxTorque = Vector3.new(1,1,1)*1e6, CFrame = root.CFrame}, root)
            end
            local dir = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + camera.CFrame.RightVector end
            bv.Velocity = dir * flySpeed
            bg.CFrame = camera.CFrame
        else
            if bv then bv:Destroy() bv = nil end
            if bg then bg:Destroy() bg = nil end
        end
    end
end)

-- 4. AUTO-FARM (Roube um Ovo)
task.spawn(function()
    while task.wait(0.1) do
        if Settings.RoubeUmOvo.AutoPegar then
            for _, obj in pairs(game.Workspace:GetDescendants()) do
                if obj.Name == "Egg" or obj:FindFirstChild("EggValue") then
                    local rar = obj:GetAttribute("Rarity") or "Comum"
                    if rar == Settings.RoubeUmOvo.Raridade then
                        -- Tenta disparar o evento de coleta
                        local remote = obj:FindFirstChildOfClass("RemoteEvent") or game:GetService("ReplicatedStorage"):FindFirstChild("CollectEgg")
                        if remote then remote:FireServer(obj) end
                        if obj:FindFirstChild("ClickDetector") then fireclickdetector(obj.ClickDetector) end
                    end
                end
            end
        end
    end
end)

