-- // LÓGICA DE BUSCA DE REMOTES (O CÉREBRO)
local Remotes = {
    Attack = nil,
    Quest = nil
}

local function ScanRemotes()
    for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local name = v.Name:lower()
            if name:find("attack") or name:find("damage") or name:find("hit") then
                Remotes.Attack = v
            elseif name:find("quest") or name:find("mission") or name:find("accept") then
                Remotes.Quest = v
            end
        end
    end
end

-- // FUNÇÕES UNIVERSAIS
local function ToggleFly(state)
    if state then
        local bv = Instance.new("BodyVelocity", Character.HumanoidRootPart)
        bv.Name = "DarkzinFly"
        bv.Velocity = Vector3.new(0,0,0)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        
        task.spawn(function()
            while task.wait() do
                if not bv.Parent then break end
                local cam = workspace.CurrentCamera.CFrame
                bv.Velocity = cam.LookVector * 50
            end
        end)
    else
        if Character.HumanoidRootPart:FindFirstChild("DarkzinFly") then
            Character.HumanoidRootPart.DarkzinFly:Destroy()
        end
    end
end

local function ToggleSpeed(val)
    Humanoid.WalkSpeed = val
end

-- // INTERFACE PRINCIPAL
function LoadMainHub()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DarkzinHubV4"
    ScreenGui.Parent = game.CoreGui
    ScreenGui.IgnoreGuiInset = true

    -- Botão Flutuante
    local OpenBtn = Instance.new("TextButton")
    OpenBtn.Parent = ScreenGui
    OpenBtn.Size = UDim2.new(0, 50, 0, 50)
    OpenBtn.Position = UDim2.new(0, 10, 0.5, 0)
    OpenBtn.Text = "DH"
    OpenBtn.BackgroundColor3 = Colors.Accent
    OpenBtn.TextColor3 = Colors.Text
    OpenBtn.Font = Enum.Font.GothamBold
    OpenBtn.TextSize = 20
    Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1, 0)

    -- Painel Principal
    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Colors.Main
    MainFrame.Position = UDim2.new(0.5, -150, 0.5, -125)
    MainFrame.Size = UDim2.new(0, 300, 0, 250)
    MainFrame.Visible = false
    Instance.new("UICorner", MainFrame)

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "DARKZIN HUB V4 - VAMPIRE LIFE"
    Title.TextColor3 = Colors.Accent
    Title.BackgroundColor3 = Colors.Secondary
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 16
    Instance.new("UICorner", Title)

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = MainFrame
    CloseBtn.Position = UDim2.new(1, -35, 0, 5)
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Text = "X"
    CloseBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    CloseBtn.TextColor3 = Colors.Text
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(1, 0)

    -- Container de Botões
    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Parent = MainFrame
    Scroll.Position = UDim2.new(0, 10, 0, 50)
    Scroll.Size = UDim2.new(0, 280, 0, 190)
    Scroll.BackgroundTransparency = 1
    Scroll.CanvasSize = UDim2.new(0, 0, 2, 0)
    Scroll.ScrollBarThickness = 4

    local Layout = Instance.new("UIListLayout", Scroll)
    Layout.Padding = UDim.new(0, 8)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function CreateButton(text, callback)
        local Btn = Instance.new("TextButton")
        Btn.Parent = Scroll
        Btn.Size = UDim2.new(0, 260, 0, 35)
        Btn.Text = text
        Btn.BackgroundColor3 = Colors.Secondary
        Btn.TextColor3 = Colors.Text
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize = 14
        Instance.new("UICorner", Btn)
        
        Btn.MouseButton1Click:Connect(function()
            callback(Btn)
        end)
    end

    -- // IMPLEMENTAÇÃO DAS FUNÇÕES
    local AutoFarm = false
    CreateButton("Auto-Farm (Auto-Scan)", function(btn)
        AutoFarm = not AutoFarm
        btn.TextColor3 = AutoFarm and Colors.Accent or Colors.Text
        
        task.spawn(function()
            while AutoFarm do
                ScanRemotes()
                if Remotes.Attack then
                    Remotes.Attack:FireServer()
                end
                task.wait(0.1)
            end
        end)
    end)

    local AutoQuest = false
    CreateButton("Auto-Quest (Auto-Scan)", function(btn)
        AutoQuest = not AutoQuest
        btn.TextColor3 = AutoQuest and Colors.Accent or Colors.Text
        
        task.spawn(function()
            while AutoQuest do
                ScanRemotes()
                if Remotes.Quest then
                    Remotes.Quest:FireServer()
                end
                task.wait(1)
            end
        end)
    end)

    local Flying = false
    CreateButton("Fly (ON/OFF)", function(btn)
        Flying = not Flying
        btn.TextColor3 = Flying and Colors.Accent or Colors.Text
        ToggleFly(Flying)
    end)

    CreateButton("Super Speed", function()
        ToggleSpeed(100)
    end)

    CreateButton("Normal Speed", function()
        ToggleSpeed(16)
    end)

    CreateButton("Anti-AFK", function(btn)
        btn.Text = "Anti-AFK: ATIVADO"
        btn.TextColor3 = Colors.Accent
        VirtualUser.Captured = true
        game:GetService("Players").LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end)

    -- Lógica de Abrir/Fechar
    OpenBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)
end

-- Iniciar
ScanRemotes()
KeySystem()
