-- // COMPONENTES DE UI
local function createToggle(parent, text, default, callback)
    local state = default
    local btn = UI.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = state and Theme.Success or Theme.Border,
        Text = text .. ": " .. (state and "ON" or "OFF"),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        AutoButtonColor = true
    }, parent)
    UI.Round(btn, 8)
    
    btn.Activated:Connect(function()
        state = not state
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        UI.Tween(btn, {BackgroundColor3 = state and Theme.Success or Theme.Border}, 0.2)
        callback(state)
    end)
    return btn
end

local function createSlider(parent, text, min, max, default, callback)
    local container = UI.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0
    }, parent)
    UI.Round(container, 10)
    
    local title = UI.Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 25),
        Position = UDim2.new(0, 10, 0, 5),
        Text = text .. ": " .. default,
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1
    }, container)
    
    local bar = UI.Create("Frame", {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.new(0, 10, 0, 35),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0
    }, container)
    UI.Round(bar, 3)
    
    local fill = UI.Create("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, bar)
    UI.Round(fill, 3)
    
    local knob = UI.Create("TextButton", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8),
        BackgroundColor3 = Theme.Text,
        Text = "",
        BorderSizePixel = 0
    }, bar)
    UI.Round(knob, 8)
    
    local dragging = false
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local relativeX = math.clamp((mouse.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(relativeX, 0, 1, 0)
            knob.Position = UDim2.new(relativeX, -8, 0.5, -8)
            local val = math.floor(min + (max - min) * relativeX)
            title.Text = text .. ": " .. val
            callback(val)
        end
    end)
    
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

