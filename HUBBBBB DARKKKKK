    -- ======================== ROLE DETECTION ========================
    local function getRole(plr)
        if not plr or plr == LocalPlayer then return "None" end
        if roleCache[plr] and tick() - (roleCache[plr]._t or 0) < 0.8 then return roleCache[plr].role end
        local role = "Innocent"
        local char = plr.Character
        if not char then roleCache[plr] = { role = "None", _t = tick() } return "None" end
        local hasKnife, hasGun = false, false
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                if n:find("knife") or n:find("blade") or n:find("dagger") or n:find("sword") then hasKnife = true end
                if n:find("gun") or n:find("revolver") or n:find("pistol") or n:find("sheriff") then hasGun = true end
            end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = string.lower(tool.Name)
                    if n:find("knife") or n:find("blade") or n:find("dagger") then hasKnife = true end
                    if n:find("gun") or n:find("revolver") or n:find("pistol") then hasGun = true end
                end
            end
        end
        local ok, val = pcall(function()
            local r = plr:FindFirstChild("Role") or plr:FindFirstChild("role") or char:FindFirstChild("Role")
            if r and (r:IsA("StringValue")) then return tostring(r.Value) end
            if plr:GetAttribute("Role") then return tostring(plr:GetAttribute("Role")) end
            if char:GetAttribute("Role") then return tostring(char:GetAttribute("Role")) end
            return nil
        end)
        if ok and val then
            local l = string.lower(val)
            if l:find("murder") then role = "Murderer"
            elseif l:find("sheriff") or l:find("hero") then role = "Sheriff"
            elseif l:find("innocent") then role = "Innocent" end
        else
            if hasKnife then role = "Murderer" elseif hasGun then role = "Sheriff" else role = "Innocent" end
        end
        roleCache[plr] = { role = role, _t = tick() }
        return role
    end

    local function getRoleColor(role)
        if role == "Murderer" then return S.MurdererColor elseif role == "Sheriff" then return S.SheriffColor else return S.InnocentColor end
    end

    local function getChar(plr) return plr and plr.Character end
    local function getHRP(plr) local c = getChar(plr) return c and c:FindFirstChild("HumanoidRootPart") end
    local function getHum(plr) local c = getChar(plr) return c and c:FindFirstChildOfClass("Humanoid") end
    local function isAlive(plr) local h = getHum(plr) return h and h.Health > 0 end
    local function worldToScreen(pos) local v, on = Camera:WorldToViewportPoint(pos) return Vector2.new(v.X, v.Y), on, v.Z end

    local function getClosestInFOV(roleFilter)
        local best, bestDist = nil, S.FOV
        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isAlive(plr) then
                local role = getRole(plr)
                if roleFilter == "Any" or role == roleFilter then
                    local hrp = getHRP(plr)
                    if hrp then
                        local part = hrp
                        if S.AimPart == "Head" then
                            local head = getChar(plr):FindFirstChild("Head")
                            if head then part = head end
                        end
                        local screen, onScreen = worldToScreen(part.Position)
                        if onScreen then
                            local d = (screen - mousePos).Magnitude
                            if d < bestDist then bestDist = d best = part end
                        end
                    end
                end
            end
        end
        return best
    end

    local function aimAt(part)
        if not part then return end
        local pos = part.Position
        if S.Prediction and part.Parent then
            local hrp = part.Parent:FindFirstChild("HumanoidRootPart") or part
            local vel = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.zero
            pos = pos + vel * S.PredMult
        end
        local screen, on = worldToScreen(pos)
        if not on then return end
        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
        local delta = (screen - mousePos) * math.clamp(1 - S.Smoothness, 0.05, 1)
        safeMousemove(delta.X, delta.Y)
    end

    -- ======================== ESP SYSTEM ========================
    local function clearESP(plr)
        local c = espCache[plr]
        if not c then return end
        for _, obj in pairs(c) do pcall(function() if obj.Remove then obj:Remove() end end) end
        espCache[plr] = nil
    end

    local function ensureESP(plr)
        if espCache[plr] then return espCache[plr] end
        local c = {
            box = safeDrawing("Square"),
            name = safeDrawing("Text"),
            dist = safeDrawing("Text"),
            health = safeDrawing("Line"),
            tracer = safeDrawing("Line"),
            skel = {},
        }
        if c.box then c.box.Thickness = 1.3 c.box.Filled = false c.box.Transparency = 1 end
        if c.name then c.name.Size = 13 c.name.Center = true c.name.Outline = true c.name.Transparency = 1 end
        if c.dist then c.dist.Size = 12 c.dist.Center = true c.dist.Outline = true c.dist.Transparency = 1 end
        if c.health then c.health.Thickness = 2.2 c.health.Transparency = 1 end
        if c.tracer then c.tracer.Thickness = 1.2 c.tracer.Transparency = 0.85 end
        for i = 1, 12 do
            local ln = safeDrawing("Line")
            if ln then ln.Thickness = 1.1 ln.Transparency = 1 c.skel[i] = ln end
        end
        espCache[plr] = c
        return c
    end

    local function updatePlayerESP()
        if not S.ESP then for plr in pairs(espCache) do clearESP(plr) end return end
        local myHRP = getHRP(LocalPlayer)
        local myPos = myHRP and myHRP.Position or Camera.CFrame.Position
        local bottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = getChar(plr)
            local hrp = getHRP(plr)
            local hum = getHum(plr)
            if not (char and hrp and hum and hum.Health > 0) then clearESP(plr) continue end
            local dist = (hrp.Position - myPos).Magnitude
            if dist > S.MaxDist then clearESP(plr) continue end
            local role = getRole(plr)
            local col = getRoleColor(role)
            local c = ensureESP(plr)
            local head = char:FindFirstChild("Head")
            local topPos = head and head.Position or (hrp.Position + Vector3.new(0, 2.2, 0))
            local bottomPos = hrp.Position - Vector3.new(0, 3, 0)
            local top2d, on1, z1 = worldToScreen(topPos)
            local bot2d, on2 = worldToScreen(bottomPos)
            local hrp2d = worldToScreen(hrp.Position)
            if not (on1 and on2) then
                if c.box then c.box.Visible = false end
                if c.name then c.name.Visible = false end
                if c.dist then c.dist.Visible = false end
                if c.health then c.health.Visible = false end
                if c.tracer then c.tracer.Visible = false end
                for _, ln in pairs(c.skel) do if ln then ln.Visible = false end end
                continue
            end
            local height = math.abs(bot2d.Y - top2d.Y)
            local width = height * 0.55
            local boxPos = Vector2.new(top2d.X - width / 2, top2d.Y)
            if S.Box and c.box then c.box.Visible = true c.box.Position = boxPos c.box.Size = Vector2.new(width, height) c.box.Color = col
            elseif c.box then c.box.Visible = false end
            if S.Name and c.name then
                c.name.Visible = true c.name.Position = Vector2.new(top2d.X, top2d.Y - 16)
                local roleTag = S.RoleESP and (" [" .. role .. "]") or ""
                c.name.Text = plr.Name .. roleTag c.name.Color = col
            elseif c.name then c.name.Visible = false end
            if S.Distance and c.dist then
                c.dist.Visible = true c.dist.Position = Vector2.new(bot2d.X, bot2d.Y + 2)
                c.dist.Text = string.format("%.0fm", dist) c.dist.Color = col
            elseif c.dist then c.dist.Visible = false end
            if S.Health and c.health then
                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                c.health.Visible = true c.health.From = Vector2.new(boxPos.X - 4, bot2d.Y)
                c.health.To = Vector2.new(boxPos.X - 4, bot2d.Y - height * pct)
                c.health.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 40)
            elseif c.health then c.health.Visible = false end
            if S.Tracer and c.tracer then
                c.tracer.Visible = true c.tracer.From = bottom c.tracer.To = hrp2d c.tracer.Color = col
            elseif c.tracer then c.tracer.Visible = false end
            if S.Skeleton then
                local bones = {{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"}, {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"}, {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"}, {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}}
                if not char:FindFirstChild("UpperTorso") then bones = {{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}} end
                for i, pair in ipairs(bones) do
                    local a = char:FindFirstChild(pair[1])
                    local b = char:FindFirstChild(pair[2])
                    local ln = c.skel[i]
                    if a and b and ln then
                        local p1, o1 = worldToScreen(a.Position)
                        local p2, o2 = worldToScreen(b.Position)
                        if o1 and o2 then ln.Visible = true ln.From = p1 ln.To = p2 ln.Color = col else ln.Visible = false end
                    elseif ln then ln.Visible = false end
                end
            else for _, ln in pairs(c.skel) do if ln then ln.Visible = false end end end
        end
        for plr in pairs(espCache) do if not Players:FindFirstChild(plr.Name) then clearESP(plr) end end
    end

    local function updateWorldESP()
        if S.CoinESP then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (string.lower(obj.Name):find("coin") or obj.Name == "CoinContainer") then
                    if not coinCache[obj] then
                        local t = safeDrawing("Text")
                        if t then t.Size = 12 t.Center = true t.Outline = true t.Color = S.CoinColor t.Text = "COIN" coinCache[obj] = t end
                    end
                    local t = coinCache[obj]
                    if t then local p, on = worldToScreen(obj.Position) t.Visible = on if on then t.Position = p end end
                end
            end
        else for obj, t in pairs(coinCache) do pcall(function() t:Remove() end) coinCache[obj] = nil end end
        if S.GunESP then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local n = string.lower(obj.Name)
                    if n:find("gun") or n:find("revolver") or n == "gundrop" then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part and not gunCache[obj] then
                            local t = safeDrawing("Text")
                            if t then t.Size = 13 t.Center = true t.Outline = true t.Color = S.GunColor t.Text = "GUN" gunCache[obj] = t end
                        end
                        local t = gunCache[obj]
                        if t and part then local p, on = worldToScreen(part.Position) t.Visible = on if on then t.Position = p end end
                    end
                end
            end
        else for obj, t in pairs(gunCache) do pcall(function() t:Remove() end) gunCache[obj] = nil end end
    end

    -- ======================== COMBAT ========================
    local function knifeAuraStep()
        if not (S.KnifeAura or S.AutoStab or S.KillAll) then return end
        if tick() - lastAura < 0.12 then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local tool = myChar:FindFirstChildOfClass("Tool")
        local isKnife = tool and string.lower(tool.Name):find("knife")
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not isAlive(plr) then continue end
            local hrp = getHRP(plr)
            if not hrp then continue end
            local dist = (hrp.Position - myHRP.Position).Magnitude
            if dist <= S.AuraDist then
                if S.KillAll or S.KnifeAura or S.AutoStab then
                    pcall(function() if tool and tool:FindFirstChild("Handle") then tool:Activate() end safeMouse1Click() end)
                    lastAura = tick() break
                end
            end
        end
    end

    local function autoShootStep()
        if not S.AutoShoot then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local tool = myChar:FindFirstChildOfClass("Tool")
        if not tool then return end
        local n = string.lower(tool.Name)
        if not (n:find("gun") or n:find("revolver") or n:find("pistol")) then return end
        local target = getClosestInFOV("Murderer")
        if target then aimAt(target) safeMouse1Click() end
    end

    -- ======================== FARM ========================
    local function farmStep()
        if not S.AutoFarm then return end
        if tick() - lastFarm < 0.15 then return end
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local best, bestD = nil, math.huge
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and string.lower(obj.Name):find("coin") then
                local d = (obj.Position - myHRP.Position).Magnitude
                if d < bestD then bestD = d best = obj end
            end
        end
        if best then
            local target = best.Position + Vector3.new(0, 2, 0)
            if S.FarmMode == "Nearest" then
                local dir = (target - myHRP.Position)
                if dir.Magnitude > 2 then myHRP.CFrame = myHRP.CFrame:Lerp(CFrame.new(target), 0.18) end
            else myHRP.CFrame = CFrame.new(target) end
            lastFarm = tick()
        end
        if S.AutoGrabGun then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                local n = string.lower(obj.Name)
                if (n:find("gun") or n:find("revolver")) and (obj:IsA("BasePart") or obj:IsA("Model")) then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part and (part.Position - myHRP.Position).Magnitude < 18 then
                        myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0)) break
                    end
                end
            end
        end
    end

    -- ======================== MOVEMENT ========================
    local function flyStep()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then return end
        if S.Fly then
            if not flyBV then
                flyBV = Instance.new("BodyVelocity") flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5) flyBV.Velocity = Vector3.zero flyBV.Parent = hrp
                flyBG = Instance.new("BodyGyro") flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5) flyBG.P = 1e4 flyBG.Parent = hrp
            end
            local cam = Camera.CFrame
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
            flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.FlySpeed or Vector3.zero
            flyBG.CFrame = cam
            hum.PlatformStand = true
        else
            if flyBV then flyBV:Destroy() flyBV = nil end
            if flyBG then flyBG:Destroy() flyBG = nil end
            if hum then hum.PlatformStand = false end
        end
    end

    local function noclipStep()
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = not S.Noclip end end
    end

    local function speedStep()
        local hum = getHum(LocalPlayer)
        if hum and S.Speed then hum.WalkSpeed = S.WalkSpeed end
    end

    -- ======================== WORLD ========================
    local function applyWorld()
        if S.FullBright then
            if not origAmbient then origAmbient = Lighting.Ambient origBrightness = Lighting.Brightness end
            Lighting.Ambient = Color3.new(1, 1, 1) Lighting.Brightness = 2
        elseif origAmbient then Lighting.Ambient = origAmbient Lighting.Brightness = origBrightness or 1 end
        if S.NoFog then
            if not origFog then origFog = Lighting.FogEnd end
            Lighting.FogEnd = 1e6
        elseif origFog then Lighting.FogEnd = origFog end
    end

