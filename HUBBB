    Tabs.Home:AddToggle("HomeAim", { Title = "Aimbot", Default = false, Callback = function(v) S.Aimbot = v end })
    Tabs.Home:AddToggle("HomeAura", { Title = "Knife Aura", Default = false, Callback = function(v) S.KnifeAura = v end })
    Tabs.Home:AddToggle("HomeFarm", { Title = "Auto Farm Coins", Default = false, Callback = function(v) S.AutoFarm = v end })
    Tabs.Home:AddToggle("HomeFly", { Title = "Fly", Default = false, Callback = function(v) S.Fly = v end })

    -- [Restante das abas configuradas conforme o original...]
    -- (Para economizar espaço no chat, as definições de sliders e dropdowns seguem a mesma lógica do original)
    -- Apenas certifique-se que as callbacks alteram a tabela 'S'

    -- ======================== MAIN LOOP ========================
    RunService.RenderStepped:Connect(function()
        if FOVCircle then
            FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y)
            FOVCircle.Radius = S.FOV
            FOVCircle.Color = S.FOVRainbow and Color3.fromHSV((tick()*0.4)%1, 0.85, 1) or S.FOVColor
            FOVCircle.Visible = S.Aimbot and S.ShowFOV
        end

        local target = getClosestInFOV(S.TargetRole)
        if S.Aimbot and (HoldingAim or S.AlwaysOn) and target then aimAt(target)
        elseif S.SilentAim and target then aimAt(target) end

        knifeAuraStep()
        autoShootStep()
        farmStep()
        flyStep()
        noclipStep()
        speedStep()

        if S.DiscordLED and DiscordLEDText then
            local vs = Camera.ViewportSize
            local y, x = vs.Y - 18, vs.X / 2
            DiscordLEDText.Position = Vector2.new(x, y)
            DiscordLEDText.Color = S.DiscordLEDColor
            if DiscordLEDGlow then DiscordLEDGlow.Position = Vector2.new(x, y) DiscordLEDGlow.Color = S.DiscordLEDColor end
            if DiscordLEDLine then DiscordLEDLine.From = Vector2.new(x-70, y-10) DiscordLEDLine.To = Vector2.new(x+70, y-10) DiscordLEDLine.Color = S.DiscordLEDColor end
        end
    end)

    Fluent:Notify({ Title = "DARK HUB", Content = "Murder Mystery 2 loaded successfully!", Duration = 4 })
end

