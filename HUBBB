        RoleESP       = true,
        Box           = true,
        Skeleton      = false,
        Tracer        = true,
        Name          = true,
        Distance      = true,
        Health        = true,
        CoinESP       = true,
        GunESP        = true,
        MaxDist       = 2500,
        MurdererColor = Color3.fromRGB(255, 55, 55),
        SheriffColor  = Color3.fromRGB(55, 140, 255),
        InnocentColor = Color3.fromRGB(80, 220, 120),
        CoinColor     = Color3.fromRGB(255, 215, 60),
        GunColor      = Color3.fromRGB(100, 180, 255),
        AutoFarm      = false,
        FarmSpeed     = 28,
        FarmMode      = "Nearest",
        AutoGrabGun   = true,
        AutoOpenChest = false,
        Fly           = false,
        FlySpeed      = 70,
        Noclip        = false,
        Speed         = false,
        WalkSpeed     = 26,
        InfiniteJump  = false,
        FullBright    = false,
        NoFog         = false,
        DiscordLED       = true,
        DiscordLEDColor  = Color3.fromRGB(188, 78, 255),
        DiscordLink      = "https://discord.gg/DARKHUB",
        AccentColor      = Color3.fromRGB(188, 78, 255),
        ThemeName        = "Darker",
    }

    -- [Lógica de Estado e Funções de MM2 mantidas do original]
    local HoldingAim = false
    local espCache, coinCache, gunCache = {}, {}, {}
    local flyBV, flyBG
    local origAmbient, origBrightness, origFog
    local lastAura, lastFarm = 0, 0
